{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/tourstk-hq",
      "destination": "/tourstk-hq/index.html"
    },
    {
      "source": "/tourstk-hq/",
      "destination": "/tourstk-hq/index.html"
    },
    {
      "source": "/tourstk-hq/index",
      "destination": "/tourstk-hq/index.html"
    },
    {
      "source": "/tourstk-hq/bookings",
      "destination": "/tourstk-hq/bookings.html"
    },
    {
      "source": "/tourstk-hq/packages",
      "destination": "/tourstk-hq/packages.html"
    },
    {
      "source": "/tourstk-hq/custom-requests",
      "destination": "/tourstk-hq/custom-requests.html"
    },
    {
      "source": "/tourstk-hq/(.*)",
      "destination": "/tourstk-hq/$1"
    },
    {
      "source": "/admin",
      "destination": "/404.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/404.html"
    },
    {
      "source": "/about",
      "destination": "/contact.html"
    }
  ]
}
