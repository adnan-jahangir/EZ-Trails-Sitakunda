{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/index",
      "destination": "/public/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/public/index.html"
    },
    {
      "source": "/packages",
      "destination": "/public/packages.html"
    },
    {
      "source": "/explore",
      "destination": "/public/explore.html"
    },
    {
      "source": "/my-booking",
      "destination": "/public/my-booking.html"
    },
    {
      "source": "/planner",
      "destination": "/public/planner.html"
    },
    {
      "source": "/contact",
      "destination": "/public/contact.html"
    },
    {
      "source": "/about",
      "destination": "/public/contact.html"
    },
    {
      "source": "/booking",
      "destination": "/public/booking.html"
    },
    {
      "source": "/package-detail",
      "destination": "/public/package-detail.html"
    },
    {
      "source": "/destination-detail",
      "destination": "/public/destination-detail.html"
    },
    {
      "source": "/admin",
      "destination": "/public/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/public/admin/index.html"
    },
    {
      "source": "/admin/index",
      "destination": "/public/admin/index.html"
    },
    {
      "source": "/admin/bookings",
      "destination": "/public/admin/bookings.html"
    },
    {
      "source": "/admin/packages",
      "destination": "/public/admin/packages.html"
    },
    {
      "source": "/admin/custom-requests",
      "destination": "/public/admin/custom-requests.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/public/admin/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
